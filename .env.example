# --- 必須 ---
DISCORD_TOKEN=
# 自分のサーバーの ID（コマンドがすぐ出る。Discord の過去ログの索引にも使う）
GUILD_ID=
# 自分のユーザー ID（入れると習慣の声かけでメンションする）
OWNER_ID=

# --- Cosense ---
COSENSE_PROJECT=YuzhNote
COSENSE_SID=
EDITOR_URL=https://liu-yuzh.github.io/yuzhnote/
# Cosense の検索用の索引を作り直す間隔（時間）
COSENSE_SYNC_HOURS=6

# --- 機能ごとのチャンネル（空の機能は動かない） ---
# URL・arXiv・DOI・PDF を貼る
INBOX_CHANNEL_ID=
# 論文ごとのスレッドを立てるフォーラムチャンネル
PAPER_FORUM_ID=
# arXiv の新着
WATCH_CHANNEL_ID=
# 毎日のボード（タスクと習慣）
TODAY_CHANNEL_ID=
# リマインダー
REMIND_CHANNEL_ID=
# 家計簿
KAKEIBO_CHANNEL_ID=
# 書くとそのまま検索になる
SEARCH_CHANNEL_ID=
# Kindle の日替わりセール
KINDLE_CHANNEL_ID=

# --- 細かい設定 ---
# arXiv の論文のスレッドを立てたとき、PDF を取って序論・結論・図を出す（1 / 0）
PDF_AUTO=1
ARXIV_CATEGORIES=cs.CL,cs.LG
ARXIV_KEYWORDS="retrieval,knowledge graph,note-taking"
WATCH_MAX=10
WATCH_HOUR=8
# この時刻で「今日」が切り替わる（夜中の作業を前の日につけられる）
DAY_START_HOUR=4
# まだの習慣を知らせる時刻
HABIT_NUDGE_HOUR=21
# Kindle の日替わりセールを流す時刻
KINDLE_HOUR=7
KAKEIBO_CATEGORIES="食費,日用品,交通,書籍・研究,趣味,医療,その他"
OCR_LANG=jpn+eng
# 写真・PDF・データベースの置き場所
DATA_DIR=data
DB_PATH=bot.db
